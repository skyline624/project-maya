{
  "exe": "{engineDir}/build/maya",
  "args": [
    "--glm-pack",
    "{dataDir}/maya-s24/pack",
    "--max-context",
    "262144",
    "--expert-cache",
    "auto",
    "--prefill",
    "auto",
    "--kv-streaming",
    "on",
    "--expert-profile",
    "{engineDir}/data/expert-profile-glm.bin",
    "--vram-reserve-mib",
    "1536",
    "--kv-resident",
    "32768"
  ],
  "cwd": "{engineDir}",
  "tokenizer": "{dataDir}/maya-s24/pack/tokenizer",
  "model_name": "glm-5.3-flash",
  "log": "{dataDir}/logs/maya.log",
  "gpu": [
    0,
    1
  ],
  "vision": {
    "exe": "{engineDir}/build/maya-vision",
    "mmproj": "{modelsDir}/glm-5.3-flash/vision/mmproj-GLM-5.3-Flash-F16.gguf",
    "model": "{modelsDir}/glm-5.3-flash/vision/GLM-5.3-Flash-vocab.gguf",
    "gpu": true,
    "max_tokens": 1024
  },
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95
  },
  "reasoning_effort": "high",
  "lib_dirs": [
    "{engineDir}/build"
  ]
}
